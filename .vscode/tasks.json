{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start SIH Dashboard",
            "type": "shell",
            "command": "${workspaceFolder}/start_dashboard.bat",
            "windows": {
                "command": "${workspaceFolder}\\start_dashboard.bat"
            },
            "group": "build",
            "presentation": {"reveal": "always", "focus": true},
            "problemMatcher": []
        },
        {
            "label": "Run SIH Tests",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pytest", "ref_sih_amr/tests", "-q"],
            "group": "test",
            "presentation": {"reveal": "always", "focus": false},
            "problemMatcher": []
        },
        {
            "label": "Run Dashboard Backend",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uvicorn", "ref_sih_amr.dashboard.backend.main:app", "--host", "0.0.0.0", "--port", "8000"],
            "group": "build",
            "presentation": {"reveal": "always", "focus": false},
            "problemMatcher": []
        }
    ]
}
